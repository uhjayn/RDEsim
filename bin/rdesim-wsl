#!/bin/sh
# Actions for the WSL Cursor tasks. Linux paths only.
#   ./bin/rdesim-wsl simulate [--case cases/annulus2D-long]
#   ./bin/rdesim-wsl prepare|build|run|open|test|optimize|cjcheck [--case PATH]
# Options after the command (--runs, --fresh, --budget also work with run,
# prepare, open, and optimize as noted):
#   --runs          keep this run in runs/<case>-<model>-<fingerprint>. The
#                   same physics resumes from its latest time; a changed case
#                   gets its own folder. Without --runs the case folder is
#                   used in place, as before.
#   --model NAME    reaction model: oneStepProgress (default), twoStep. This
#                   overrides reaction.model in rdeConfig. With --runs each model
#                   has its own run folder.
#   --fresh         delete earlier result times of this run (optimize: the
#                   stored evaluations) before starting
#   --budget N      optimize only: start at most N new solver evaluations
# Edit the case rdeConfig and fuels/<name>/fuelDict. This script does
# not change the physics. It does not call an agent or a remote API.

set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
CASE="$ROOT/cases/annulus2D"
CONFIG="$CASE/rdeConfig"
CASE_NAME="annulus2D"
CASE_REL="cases/annulus2D"
FOAM_FILE="$CASE/annulus2D.foam"

usage() {
    echo "Usage: ./bin/rdesim-wsl simulate|prepare|run|open|cells [--case PATH] [--model NAME] [--runs] [--fresh]" >&2
    echo "       ./bin/rdesim-wsl optimize [--case PATH] [--model NAME] [--fresh] [--budget N]" >&2
    echo "       ./bin/rdesim-wsl build|test" >&2
    echo "       ./bin/rdesim-wsl cjcheck [--case PATH] [--model NAME]" >&2
    echo "  simulate source OpenFOAM, prepare, build if needed, run, open ParaView" >&2
    echo "  prepare  write the case from its rdeConfig" >&2
    echo "  build    source OpenFOAM 14 and run Allwmake" >&2
    echo "  run      source OpenFOAM 14 and run the case Allrun" >&2
    echo "  open     start Windows ParaView on the latest result in the case" >&2
    echo "  cells    print the mesh-resolution report and render pMax with pvbatch" >&2
    echo "  test     Allwmake, unit tests, then blockMesh and foamRun on annulus2D" >&2
    echo "  cjcheck  1D tube: measured detonation speed against Chapman-Jouguet for the model" >&2
    echo "  optimize run python3 -m rdesim optimize; finished evaluations are reused" >&2
    echo "  --case   case directory, default cases/annulus2D" >&2
    echo "  --runs   keep results in runs/<case>-<model>-<fingerprint>; the same physics resumes" >&2
    echo "  --fresh  delete earlier result times (optimize: stored evaluations) first" >&2
    echo "  --budget optimize only: at most N new solver evaluations" >&2
    echo "           example: ./bin/rdesim-wsl simulate --case cases/annulus2D-long" >&2
}

# Point CASE, CONFIG, and the .foam stub at one case directory.
select_case() {
    rel="$1"
    case "$rel" in
        /*) CASE="$rel" ;;
        *) CASE="$ROOT/$rel" ;;
    esac
    CASE="${CASE%/}"
    if [ ! -f "$CASE/rdeConfig" ]; then
        die "No rdeConfig in $CASE. --case is a case directory such as cases/annulus2D or cases/annulus2D-long."
    fi
    CONFIG="$CASE/rdeConfig"
    CASE_NAME="$(basename "$CASE")"
    FOAM_FILE="$CASE/${CASE_NAME}.foam"
    case "$CASE" in
        "$ROOT"/*) CASE_REL="${CASE#"$ROOT"/}" ;;
        *) CASE_REL="$CASE" ;;
    esac
}

die() {
    echo "rdesim-wsl: $*" >&2
    exit 1
}

openfoam_bashrc() {
    package="/opt/openfoam14/etc/bashrc"
    source_tree="$HOME/OpenFOAM/OpenFOAM-14/etc/bashrc"
    if [ -f "$package" ]; then
        echo "$package"
        return 0
    fi
    if [ -f "$source_tree" ]; then
        echo "$source_tree"
        return 0
    fi
    die "OpenFOAM 14 bashrc was not found. Looked for $package and $source_tree. Install openfoam14 in this Ubuntu distro, or unpack OpenFOAM-14 under ~/OpenFOAM."
}

source_openfoam() {
    bashrc="$(openfoam_bashrc)"
    echo "Sourcing $bashrc"
    # The OpenFOAM bashrc reads variables it does not set itself.
    set +eu
    # shellcheck disable=SC1090
    . "$bashrc"
    set -eu
    if [ -z "${WM_PROJECT_DIR:-}" ]; then
        die "Sourced $bashrc but WM_PROJECT_DIR is still empty."
    fi
    if ! command -v foamRun >/dev/null 2>&1; then
        die "Sourced $bashrc but foamRun is not on PATH."
    fi
}

latest_result_time() {
    CASE="$1" python3 - <<'PY'
import math
import os
from pathlib import Path

case = Path(os.environ["CASE"])
best = None
for path in case.iterdir():
    if not path.is_dir():
        continue
    try:
        value = float(path.name)
    except ValueError:
        continue
    if not math.isfinite(value) or value <= 0:
        continue
    if best is None or value > best[0]:
        best = (value, path.name)
if best is None:
    raise SystemExit(1)
print(best[1])
PY
}

# Linux path of paraview.exe. RDESIM_PARAVIEW_EXE wins when it points at a file.
# Otherwise the highest version under Program Files, Program Files (x86), or a
# per-user AppData\Local install. An unmatched glob is not a file, so -f rejects it.
windows_paraview() {
    if [ -n "${RDESIM_PARAVIEW_EXE:-}" ]; then
        if [ -f "$RDESIM_PARAVIEW_EXE" ]; then
            printf '%s\n' "$RDESIM_PARAVIEW_EXE"
            return 0
        fi
        if command -v wslpath >/dev/null 2>&1; then
            unix_exe="$(wslpath -u "$RDESIM_PARAVIEW_EXE" 2>/dev/null || true)"
            if [ -n "$unix_exe" ] && [ -f "$unix_exe" ]; then
                printf '%s\n' "$unix_exe"
                return 0
            fi
        fi
        die "RDESIM_PARAVIEW_EXE is set but that file was not found: $RDESIM_PARAVIEW_EXE"
    fi

    set --
    # shellcheck disable=SC2086
    for candidate in \
        "/mnt/c/Program Files"/ParaView*/bin/paraview.exe \
        "/mnt/c/Program Files (x86)"/ParaView*/bin/paraview.exe \
        /mnt/c/Users/*/AppData/Local/ParaView*/bin/paraview.exe \
        /mnt/c/Users/*/AppData/Local/Programs/ParaView*/bin/paraview.exe
    do
        if [ -f "$candidate" ]; then
            set -- "$@" "$candidate"
        fi
    done
    if [ "$#" -eq 0 ]; then
        return 1
    fi
    printf '%s\n' "$@" | sort -V | tail -n 1
}

paraview_missing_message() {
    cat >&2 <<'EOF'
Windows ParaView was not found. Set RDESIM_PARAVIEW_EXE to the full path of paraview.exe, or install ParaView where one of these globs matches:
  /mnt/c/Program Files/ParaView*/bin/paraview.exe
  /mnt/c/Program Files (x86)/ParaView*/bin/paraview.exe
  /mnt/c/Users/*/AppData/Local/ParaView*/bin/paraview.exe
  /mnt/c/Users/*/AppData/Local/Programs/ParaView*/bin/paraview.exe
/mnt/c must be the Windows C: drive. A name such as "ParaView 6.2.0" matches ParaView*.
EOF
}

solver_library() {
    printf '%s\n' "${FOAM_USER_LIBBIN}/librdeFluidSolver.so"
}

# Rebuild when the library is absent or a solver source is newer than it.
solver_needs_build() {
    library="$1"
    if [ ! -f "$library" ]; then
        return 0
    fi
    find "$ROOT/applications/modules/rdeFluid" -type f \
        \( -name '*.C' -o -name '*.H' -o -path '*/Make/files' -o -path '*/Make/options' \) \
        -newer "$library" -print -quit | grep -q .
}

# \\wsl.localhost\<distro>\<linux path> or \\wsl$\<distro>\<linux path>
wsl_unc() {
    prefix="$1"
    linux_path="$2"
    if [ -z "${WSL_DISTRO_NAME:-}" ]; then
        die "WSL_DISTRO_NAME is not set, so the Windows case path cannot be built. Run this from the Ubuntu distro in WSL, including Cursor's WSL window."
    fi
    case "$linux_path" in
        /*) ;;
        *) die "Case path is not absolute: $linux_path" ;;
    esac
    relative="${linux_path#/}"
    relative_win="$(printf '%s' "$relative" | sed 's|/|\\|g')"
    printf '%s\n' "${prefix}\\${WSL_DISTRO_NAME}\\${relative_win}"
}

to_windows_path() {
    linux_path="$1"
    if ! command -v wslpath >/dev/null 2>&1; then
        die "wslpath was not found, so the Linux path cannot be converted for Windows: $linux_path"
    fi
    wslpath -w "$linux_path"
}

# One Windows path per line. wslpath -w first, then \\wsl.localhost\, then \\wsl$\.
case_windows_paths() {
    linux_path="$1"
    converted=""
    if command -v wslpath >/dev/null 2>&1; then
        converted="$(wslpath -w "$linux_path" 2>/dev/null || true)"
    fi
    if [ -n "$converted" ]; then
        printf '%s\n' "$converted"
    fi
    if [ -n "${WSL_DISTRO_NAME:-}" ]; then
        wsl_unc '\\wsl.localhost' "$linux_path"
        wsl_unc '\\wsl$' "$linux_path"
    fi
}

cmd_prepare() {
    cd "$ROOT"
    if [ "$USE_RUNS" -eq 1 ]; then
        python3 -m rdesim prepare --config "$CONFIG" --run-folder --runs-root "$RUNS_ROOT" ${MODEL:+--model "$MODEL"}
    else
        python3 -m rdesim prepare --config "$CONFIG" --case "$CASE" ${MODEL:+--model "$MODEL"}
    fi
}

# --runs: point CASE at runs/<case>-<model>-<fingerprint> for this config.
select_run_folder() {
    if [ "$USE_RUNS" -eq 1 ]; then
        CASE="$(cd "$ROOT" && python3 -m rdesim run-dir --config "$CONFIG" --runs-root "$RUNS_ROOT" ${MODEL:+--model "$MODEL"})"
        FOAM_FILE="$CASE/$(basename "$CASE").foam"
        CASE_REL="$CASE"
        echo "Run folder: $CASE"
    fi
}

cmd_build() {
    cd "$ROOT"
    source_openfoam
    ./Allwmake
}

cmd_build_if_needed() {
    cd "$ROOT"
    if [ -z "${FOAM_USER_LIBBIN:-}" ]; then
        die "FOAM_USER_LIBBIN is empty after sourcing OpenFOAM, so the solver library cannot be found."
    fi
    library="$(solver_library)"
    if solver_needs_build "$library"; then
        if [ ! -f "$library" ]; then
            echo "Solver library is missing ($library). Building."
        else
            echo "Solver sources are newer than $library. Building."
        fi
        ./Allwmake
        if [ ! -f "$library" ]; then
            die "Allwmake finished but $library is still missing."
        fi
    else
        echo "Solver library is up to date: $library"
    fi
}

cmd_run() {
    cd "$ROOT"
    select_run_folder
    source_openfoam
    if [ -z "${FOAM_USER_LIBBIN:-}" ] || [ ! -e "$FOAM_USER_LIBBIN/librdeFluidSolver.so" ]; then
        die "librdeFluidSolver.so is not in FOAM_USER_LIBBIN. Run the Cursor task \"RDEsim: Build solver\" first (./bin/rdesim-wsl build)."
    fi
    (cd "$CASE" && ./Allrun)
}

how_to_open_result() {
    time_name="$1"
    echo "The $CASE_NAME result is still on disk."
    echo "Latest result time folder: $CASE/$time_name"
    echo "If paraview.exe starts and no window appears, reinstall ParaView on Windows."
    echo "In ParaView, choose File → Open and paste this path:"
    if [ -n "${WSL_DISTRO_NAME:-}" ]; then
        wsl_unc '\\wsl.localhost' "$FOAM_FILE"
        echo "If that path does not open, paste this one instead:"
        wsl_unc '\\wsl$' "$FOAM_FILE"
    else
        printf '%s\n' "\\\\wsl.localhost\\<distro>\\${FOAM_FILE#/}" | sed 's|/|\\|g'
        echo "Replace <distro> with the name from wsl.exe -l -q. WSL_DISTRO_NAME is not set in this shell."
    fi
    echo "Colour p, then T, rho, U, and lambda. Step the time slider to $time_name."
}

# powershell Start-Process detaches in the Windows session. A direct
# paraview.exe launch from this shell only creates a WSL interop pid.
# The plain command is printed; EncodedCommand keeps spaces and backslashes.
start_paraview_detached() {
    exe_win="$1"
    case_win="$2"
    exe_ps="$(printf '%s' "$exe_win" | sed "s/'/''/g")"
    case_ps="$(printf '%s' "$case_win" | sed "s/'/''/g")"
    plain="Start-Process -FilePath '${exe_ps}' -ArgumentList '${case_ps}'"
    if command -v powershell.exe >/dev/null 2>&1; then
        printf '%s\n' "Command: powershell.exe -NoProfile -Command \"${plain}\""
        # UTF-16LE base64 is powershell -EncodedCommand. It keeps spaces in
        # "Program Files" and backslashes in the \\wsl$\ path intact.
        encoded="$(printf '%s' "$plain" | iconv -f UTF-8 -t UTF-16LE | base64 -w 0)"
        set +e
        powershell.exe -NoProfile -EncodedCommand "$encoded" </dev/null
        code=$?
        set -e
        echo "Exit code: $code"
        return 0
    fi
    if command -v cmd.exe >/dev/null 2>&1; then
        bat="$(mktemp --suffix=.cmd)"
        printf 'start "" "%s" "%s"\r\n' "$exe_win" "$case_win" >"$bat"
        bat_win="$(to_windows_path "$bat")"
        printf '%s\n' "Command: cmd.exe /c start \"\" \"${exe_win}\" \"${case_win}\""
        set +e
        cmd.exe /c "$bat_win" </dev/null
        code=$?
        set -e
        rm -f "$bat"
        echo "Exit code: $code"
        return 0
    fi
    echo "powershell.exe and cmd.exe were not found. ParaView was not started." >&2
    return 127
}

# Prints tasklist output. Returns 0 when Windows lists paraview.exe.
windows_paraview_listed() {
    if ! command -v tasklist.exe >/dev/null 2>&1; then
        echo "tasklist.exe was not found, so the Windows process was not checked."
        return 2
    fi
    set +e
    listing="$(tasklist.exe /FI "IMAGENAME eq paraview.exe" 2>&1)"
    set -e
    printf '%s\n' "$listing"
    printf '%s\n' "$listing" | grep -qi 'paraview\.exe'
}

# Ask Windows to start ParaView and accept success only from tasklist.exe.
# Tries wslpath -w, then \\wsl.localhost\, then \\wsl$\ if the process is absent.
launch_windows_paraview() {
    time_name="$1"
    if [ ! -f "$FOAM_FILE" ]; then
        die "Missing $FOAM_FILE. Run the Cursor task \"RDEsim: Prepare case\" first."
    fi
    if [ ! -d "$CASE/$time_name" ]; then
        die "Result time folder $CASE/$time_name is not on disk."
    fi
    if ! paraview="$(windows_paraview)"; then
        paraview_missing_message >&2
        how_to_open_result "$time_name" >&2
        return 1
    fi
    exe_win="$(to_windows_path "$paraview")"
    echo "Latest result time folder: $CASE/$time_name"
    echo "ParaView executable: $paraview"
    printf '%s\n' "Windows executable path: $exe_win"

    paths="$(case_windows_paths "$FOAM_FILE")"
    if [ -z "$paths" ]; then
        die "No Windows path could be built for $FOAM_FILE"
    fi

    wait_s="${RDESIM_PARAVIEW_WAIT:-3}"
    unique_paths="$(printf '%s\n' "$paths" | awk 'NF && !seen[$0]++')"
    found=0
    # The here-document keeps this loop in the current shell so `found` is visible.
    while IFS= read -r case_win; do
        [ -n "$case_win" ] || continue
        printf '%s\n' "Opening $case_win"
        if ! start_paraview_detached "$exe_win" "$case_win"; then
            echo "Windows ParaView was not started." >&2
            how_to_open_result "$time_name" >&2
            return 1
        fi
        sleep "$wait_s"
        echo "tasklist.exe /FI \"IMAGENAME eq paraview.exe\""
        if windows_paraview_listed </dev/null; then
            found=1
            break
        fi
        echo "tasklist.exe did not list paraview.exe after this launch."
    done <<EOF
$unique_paths
EOF
    if [ "$found" -eq 1 ]; then
        echo "Windows reports paraview.exe is running."
        echo "Colour p, then T, rho, U, and lambda."
        echo "Step the time slider to $time_name."
        return 0
    fi

    echo "Windows Task Manager has no paraview.exe. The launch did not start ParaView." >&2
    echo "The command and its exit code are printed above." >&2
    how_to_open_result "$time_name" >&2
    return 1
}

cmd_open() {
    select_run_folder
    if ! time_name="$(latest_result_time "$CASE")"; then
        die "No result time folder in $CASE yet. The initial 0/ directory is not a result. Run ./bin/rdesim-wsl run --case $CASE_REL and wait for Allrun to finish."
    fi
    launch_windows_paraview "$time_name" || exit 1
}

cmd_open_result() {
    if ! time_name="$(latest_result_time "$CASE")"; then
        die "Allrun finished but no result time folder was written in $CASE. The initial 0/ directory is not a result."
    fi
    launch_windows_paraview "$time_name" || exit 1
}

clear_result_times() {
    CASE="$1" python3 - <<'PY'
import math
import os
import shutil
from pathlib import Path

case = Path(os.environ["CASE"])
for path in case.iterdir():
    if not path.is_dir():
        continue
    try:
        value = float(path.name)
    except ValueError:
        continue
    if math.isfinite(value) and value > 0:
        shutil.rmtree(path)
PY
}

# Build, unit tests, then a fresh annulus2D run. Stops at the first failure.
# The initial 0/ directory is kept. Result time folders from an earlier run
# are removed so the folder foamRun writes is from this test.
cmd_test() {
    cd "$ROOT"
    select_case "cases/annulus2D"
    source_openfoam
    ./Allwmake
    python3 -m unittest tests.test_rdesim tests.test_runs tests.test_reaction_models
    (cd "$CASE" && ./Allclean)
    clear_result_times "$CASE"
    (cd "$CASE" && blockMesh && foamRun)
    if ! time_name="$(latest_result_time "$CASE")"; then
        die "foamRun finished but no result time folder was written in $CASE. The initial 0/ directory is not a result."
    fi
    echo "$CASE_NAME wrote result time folder $time_name"
}

# Print the chemical-length report, then ask pvbatch to draw pMax and the mesh.
# Windows pvbatch.exe is preferred so the same ParaView install is used.
cmd_cells() {
    cd "$ROOT"
    select_run_folder
    python3 -m rdesim resolution --config "$CONFIG"
    script="$ROOT/paraview/cell_structure.py"
    if [ ! -f "$FOAM_FILE" ]; then
        die "Missing $FOAM_FILE. Run ./bin/rdesim-wsl prepare first."
    fi
    batch=""
    if paraview="$(windows_paraview 2>/dev/null || true)" && [ -n "$paraview" ]; then
        candidate="$(dirname "$paraview")/pvbatch.exe"
        if [ -f "$candidate" ]; then
            batch="$candidate"
        fi
    fi
    if [ -z "$batch" ] && command -v pvbatch >/dev/null 2>&1; then
        batch="$(command -v pvbatch)"
    fi
    if [ -z "$batch" ]; then
        echo "pvbatch was not found, so no image was written." >&2
        echo "After a run, from the ParaView install:" >&2
        printf '%s\n' "pvbatch --force-offscreen-rendering \"$script\" \"$CASE\"" >&2
        echo "pMax is a pressure history. It is not a measured cell width." >&2
        return 0
    fi
    echo "pvbatch: $batch"
    echo "pMax is a pressure history. It is not a measured cell width."
    set +e
    "$batch" --force-offscreen-rendering "$script" "$CASE"
    code=$?
    set -e
    if [ "$code" -ne 0 ]; then
        die "pvbatch exited $code. The mesh-resolution report above is still the cell-size check."
    fi
}

# One entry point: source, prepare, build only if needed, run, then open.
# Each step stops the script on failure. A missing ParaView does not delete
# the case that Allrun just wrote.
cmd_simulate() {
    cd "$ROOT"
    select_run_folder
    source_openfoam
    cmd_prepare
    cmd_build_if_needed
    if [ "$FRESH" -eq 1 ]; then
        clear_result_times "$CASE"
    fi
    (cd "$CASE" && ./Allrun)
    cmd_open_result
}

# Evaluations are cases of their own. Each one runs blockMesh and foamRun and
# resumes from its latest time, so Ctrl-C and a later repeat lose little.
cmd_optimize() {
    cd "$ROOT"
    source_openfoam
    cmd_build_if_needed
    set -- --config "$CONFIG"
    if [ -n "$MODEL" ]; then
        set -- "$@" --model "$MODEL"
    fi
    if [ -n "$BUDGET" ]; then
        set -- "$@" --budget "$BUDGET"
    fi
    if [ "$FRESH" -eq 1 ]; then
        set -- "$@" --fresh
    fi
    python3 -m rdesim optimize "$@"
}

# One-dimensional tube with the selected model. The case is written to
# runs/cjcheck-<model> and rewritten on every call.
cmd_cjcheck() {
    cd "$ROOT"
    source_openfoam
    cmd_build_if_needed
    name="${MODEL:-$(python3 -c "import sys; from rdesim.config import load_config, reaction_model; print(reaction_model(load_config(sys.argv[1])))" "$CONFIG")}"
    python3 -m rdesim.cjcheck --config "$CONFIG" ${MODEL:+--model "$MODEL"} --case "$RUNS_ROOT/cjcheck-$name"
}

COMMAND=""
CASE_OPT=""
USE_RUNS=0
FRESH=0
BUDGET=""
MODEL=""
RUNS_ROOT="${RDESIM_RUNS:-$ROOT/runs}"
while [ "$#" -gt 0 ]; do
    case "$1" in
        --case)
            shift
            if [ "$#" -lt 1 ]; then
                die "--case needs a case directory, for example cases/annulus2D-long."
            fi
            CASE_OPT="$1"
            ;;
        --case=*)
            CASE_OPT="${1#--case=}"
            ;;
        --runs) USE_RUNS=1 ;;
        --fresh) FRESH=1 ;;
        --model)
            shift
            if [ "$#" -lt 1 ]; then
                die "--model needs a name"
            fi
            MODEL="$1"
            ;;
        --model=*)
            MODEL="${1#--model=}"
            ;;
        --budget)
            shift
            if [ "$#" -lt 1 ]; then
                die "--budget needs a number"
            fi
            BUDGET="$1"
            ;;
        --budget=*)
            BUDGET="${1#--budget=}"
            ;;
        -*)
            die "Unknown option $1. Use --case PATH, --model NAME, --runs, --fresh, or --budget N."
            ;;
        *)
            if [ -n "$COMMAND" ]; then
                die "Unexpected argument $1"
            fi
            COMMAND="$1"
            ;;
    esac
    shift
done

if [ -z "$COMMAND" ]; then
    usage
    exit 1
fi

if [ -n "$BUDGET" ] && [ "$COMMAND" != "optimize" ]; then
    die "--budget only applies to optimize."
fi

case "$COMMAND" in
    simulate|prepare|run|open|cells|optimize|cjcheck)
        select_case "${CASE_OPT:-cases/annulus2D}"
        ;;
    build|test)
        if [ -n "$CASE_OPT" ]; then
            die "--case cannot be used with $COMMAND. The smoke case is cases/annulus2D."
        fi
        ;;
    *)
        usage
        exit 1
        ;;
esac

case "$COMMAND" in
    simulate) cmd_simulate ;;
    prepare) cmd_prepare ;;
    build) cmd_build ;;
    run) cmd_run ;;
    open) cmd_open ;;
    cells) cmd_cells ;;
    test) cmd_test ;;
    optimize) cmd_optimize ;;
    cjcheck) cmd_cjcheck ;;
esac
