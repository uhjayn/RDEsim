FoamFile
{
    format      ascii;
    class       dictionary;
    object      fuelDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Illustrative hydrogen-air library entry. These numbers are a starting
// point for the one-step model. They are not a validated detonation mechanism.

fuel
{
    name        H2;
    molWeight   0.002016;
}

oxidizer
{
    oxygenMoleFraction  0.21;
    species
    (
        { name O2; molWeight 0.031998; moleFraction 0.21; }
        { name N2; molWeight 0.028014; moleFraction 0.79; }
    );
}

stoichiometry
{
    // 2 H2 + O2 -> products, with N2 carried in the oxidizer mixture.
    nuFuel      2;
    nuOxygen    1;
}

heatRelease
{
    // Lower heating value of the fuel, J/kg of fuel.
    LHV         1.2e8;
}

thermo
{
    model               hConst;
    equationOfState     perfectGas;
    composition         frozenReactants;
    gamma               1.4;
    hf                  0;
    productMolWeight    0.024;
    productGamma        1.24;
}

transport
{
    // Used only when numerics.flowModel is navierStokes.
    mu              1.8e-5;
    Pr              0.7;
}

chemistry
{
    model                   oneStepProgress;
    A                       1.0e8;
    beta                    0;
    Ta                      10000;
    TRef                    300;
    TFloor                  200;
    ignitionTemperature     1200;
    lambdaMin               0;
    lambdaMax               1;
}

// Two-step induction-then-heat-release model, used when rdeConfig has
//   reaction { model twoStep; }
// (Short-Sharpe style, Short and Sharpe, Combust. Theory Model. 7 (2003) 401.)
//   d(xi)/dt     = inductionA exp(-inductionTa/T)           xi runs 0 -> 1, no heat
//   d(lambda)/dt = releaseA exp(-releaseTa/T) (1-lambda)^releaseOrder   only once xi = 1
// Heat released is q * d(lambda), with q from heatRelease.LHV and the mixture.
// 1/inductionRate is the induction time, so xi = integral of dt/tau_ind(T).
//
// Provenance of the numbers below. inductionA and inductionTa are a least
// squares fit of ln(1/tau) against 1/T to the constant-volume ignition delay
// (maximum dT/dt) of stoichiometric H2-air from the Burke et al. 2012 mechanism
// in Cantera 3.2, at 20 bar, T = 1400 to 1900 K. The fit is within 7 % of those
// ignition delays over that range and only there. Script:
// fuels/hydrogen-air/detailed/burke2012/fit_two_step.py. releaseA is
// ln(9)/(10-90 % duration of the temperature rise) at 20 bar: that duration is
// 0.27 to 0.30 microseconds for T = 1300 to 1900 K, so releaseTa is 0. The
// chain-branching release of the real mechanism is not first order, so this
// matches its duration, not its shape. They are a starting point to edit.

twoStep
{
    inductionA      4.49e8;
    inductionTa     8882;
    releaseA        8.0e6;
    releaseTa       0;
    releaseOrder    1;
}

// Detailed multi-species chemistry, used when rdeConfig has
//   reaction { model detailed; }
// The mechanism is Burke et al. (2012), H2/O2, kept to the H2-air species
// (H H2 O OH H2O O2 HO2 H2O2 N2, 23 reactions). Its thermo (NASA-7) and
// reactions files are in the directory below, with their source and how they
// were converted. The fuel name and the oxidizer species above must be names
// in that mechanism. Euler only: the mechanism files carry no transport data.
//   TMin                    cells colder than this skip the chemistry step
//                           (cost control; ignition delays at lower T are far
//                           longer than any run of this solver)
//   ode                     OpenFOAM ODESolver settings (seulex, Rosenbrock34,
//                           rodas23, ...) for the constant-volume cell problem
//   initialChemicalTimeStep first sub-step guess, s

detailed
{
    mechanism                   "detailed/burke2012";
    TMin                        500;
    initialChemicalTimeStep     1e-9;
    ode
    {
        solver                  seulex;
        absTol                  1e-10;
        relTol                  1e-6;
    }
}

