FoamFile
{
    format      ascii;
    class       dictionary;
    object      fuelDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Calibrated copy of fuels/hydrogen-air/fuelDict for the detonation-tube validation.
// Only heatRelease.LHV, chemistry.A and chemistry.Ta differ from the original.
// Written by `python3 -m rdesim.validation calibrate --write`; see the
// calibration block at the end of this file. Valid for stoichiometric H2-air
// at 300 K and 1 atm. Not a predictive detonation chemistry.

fuel
{
    name        H2;
    molWeight   0.002016;
}

oxidizer
{
    oxygenMoleFraction  0.21;
    species
    (
        { name O2; molWeight 0.031998; moleFraction 0.21; }
        { name N2; molWeight 0.028014; moleFraction 0.79; }
    );
}

stoichiometry
{
    // 2 H2 + O2 -> products, with N2 carried in the oxidizer mixture.
    nuFuel      2;
    nuOxygen    1;
}

heatRelease
{
    // Lower heating value of the fuel, J/kg of fuel.
    LHV         6.48544e+07;
}

thermo
{
    model               hConst;
    equationOfState     perfectGas;
    composition         frozenReactants;
    gamma               1.4;
    hf                  0;
    productMolWeight    0.024;
    productGamma        1.24;
}

transport
{
    // Used only when numerics.flowModel is navierStokes.
    mu              1.8e-5;
    Pr              0.7;
}

chemistry
{
    model                   oneStepProgress;
    A                       3.00173e+08;
    beta                    0;
    Ta                      10478.8;
    TRef                    300;
    TFloor                  200;
    ignitionTemperature     1200;
    lambdaMin               0;
    lambdaMax               1;
}

// What was calibrated. Not read by the solver. The original values are kept
// here and in fuels/hydrogen-air/fuelDict.
calibration
{
    reference       "Cantera gri30.yaml CJ state and steady ZND profile, tools/validation_reference.py";
    mixture         "stoichiometric H2-air, p0 101325 Pa, T0 300 K";
    targets
    {
        waveSpeed           1969.02;   // m/s, CJ speed
        halfHeatReleaseLength 0.000273367;   // m, distance to half the heat release in the ZND profile
        reducedActivationEnergy 5;   // Ea/(R T_vN) of the time to half heat release
        referenceReducedActivationEnergy 9.34981;   // the Cantera value, for comparison
    }
    original
    {
        LHV     1.2e+08;
        A       1e+08;
        Ta      10000;
    }
    calibrated
    {
        LHV     6.48544e+07;
        A       3.00173e+08;
        Ta      10478.8;
    }
    note            "LHV is q/Yf with q set by the CJ speed for one gamma. It is an effective number, about half the real H2 lower heating value, that absorbs what one gamma of 1.4 cannot represent. It is not a heat of reaction.";
}

