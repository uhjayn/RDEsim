FoamFile
{
    format      ascii;
    class       dictionary;
    object      rdeConfig;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Top-level user configuration. All values are SI. Edit this file, then run
// `python3 -m rdesim prepare`. Regenerating overwrites the OpenFOAM
// dictionaries in this case. Nothing in the solver supplies a hidden
// replacement for a value you set here or in the fuel file.

constants
{
    RUniversal          8.314462618;
}

domain
{
    dimension           2;              // 2 or 3
    topology            unwrapped;      // unwrapped | meridional
    RInner              0.04;
    ROuter              0.05;
    axialLength         0.12;
    sectorAngle         30;             // degrees
    theta0              0;              // degrees, 3D sector start
    emptyThickness      0.001;          // empty-direction thickness for 2D
    axialReference      0;              // axial station where wall angles are zero
    unwrapRadius        mean;           // mean | inner | outer
}

mesh
{
    nCircumferential            40;
    nAxial                      48;
    nRadial                     1;
    nCircumferentialBlocks      4;
    axialGrading                1;
    circumferentialGrading      1;
    radialGrading               1;
    minCellsPerBlock            1;
    stationTolerance            1e-8;
}

geometry
{
    innerWallAngle      0;              // degrees, positive grows radius downstream
    outerWallAngle      0;
    widthAnchor         outer;          // inner | outer | centre
    widthProfile
    (
    );
    steps
    (
        {
            side        outer;
            location    0.04;
            height      0.002;
            angle       90;             // 90 is a vertical face; less is a ramp
        }
    );
    nozzle
    {
        enabled         yes;
        start           0.09;
        length          0.03;
        shape           conical;        // conical | piecewise
        anchor          outer;
        throatFraction  0.5;
        throatGap       0.008;
        exitGap         0.012;
        profile
        (
        );
    }
    injector
    {
        nSlots          4;
        slotWidth       0.002;
        recessDepth     0.002;
        injectionAngle  0;              // degrees from axial toward circumferential
        phase           0;
    }
}

operating
{
    pInlet              101325;
    TInlet              300;
    pOutlet             101325;
    TOutlet             300;
    equivalenceRatio    1;
    massFlowRate        0.02;           // kg/s through the meshed sector
    plenumPressure      400000;
    plenumTemperature   300;
    inletModel          massFlow;       // fixedVelocity | massFlow | isentropicPlenum
    inletVelocity
    {
        circumferential 0;
        axial           50;
        radial          0;
    }
}

fuel
{
    name                hydrogen-air;
    library             fuels;
}

// Optional deep override of the selected fuelDict. Empty leaves the library entry.
fuelOverrides
{
}

numerics
{
    flowModel           euler;          // euler | navierStokes
    fluxScheme          Kurganov;       // Kurganov | Tadmor
    ddtScheme           Euler;
    gradScheme          Gauss linear;
    laplacianScheme     Gauss linear orthogonal;
    reconstructScalar   vanAlbada;
    reconstructVector   vanAlbadaV;
    fluxInterpolation   linear;
    CFL                 0.2;
    deltaT              1e-8;
    maxDeltaT           2e-7;
    startTime           0;
    endTime             5e-6;           // short first-run window, not a burnout time
    adjustTimeStep      yes;
    deltaTFactor        1.2;
    writeFormat         ascii;
    writePrecision      8;
    timePrecision       8;
    runTimeModifiable   yes;
    sourceIntegration   pointImplicit;  // pointImplicit | explicit
    fvSolution
    {
        solvers
        {
            rho
            {
                solver          diagonal;
            }
            lambda
            {
                solver          diagonal;
            }
            U
            {
                solver          smoothSolver;
                smoother        GaussSeidel;
                nSweeps         2;
                tolerance       1e-9;
                relTol          0.01;
            }
            e
            {
                solver          smoothSolver;
                smoother        GaussSeidel;
                nSweeps         2;
                tolerance       1e-10;
                relTol          0;
            }
        }
        PIMPLE
        {
            nOuterCorrectors    2;
        }
    }
    momentumTransport
    {
        simulationType  laminar;
    }
    thermophysicalTransport
    {
        laminar
        {
            model       Fourier;
            Pr          0.7;
        }
    }
}

hyperbolicity
{
    requireStrictlyHyperbolic   yes;
    gammaMin                    1.0000001;
    rhoMin                      1e-8;
    pMin                        1;
    TMin                        1;
    c2Min                       1;
    maxCoStability              1;
    sourceDependsOnGradients    no;
    boundaryCoupling            local;
    hyperbolicFluxSchemes       (Kurganov Tadmor);
    hyperbolicEquationsOfState  (perfectGas);
    localSourceIntegrations     (pointImplicit explicit);
}

boundaries
{
    inlet
    {
        p               zeroGradient;
        T               fixedValue;
        U               fixedValue;
    }
    outlet
    {
        type            waveTransmissive;   // waveTransmissive | zeroGradient | fixedValue
        lInf            0.12;
    }
    walls
    {
        velocityModel   acoustic;           // slip | acoustic
    }
    acoustics
    {
        targetPatches       (inletWall injectorSide);
        mode                microstructure; // impedance | reflection | microstructure
        timeDomainModel     helmholtz;      // slip | resistive | helmholtz
        frequency           8000;
        incidenceAngleDeg   0;
        ZReal               1.0e6;
        ZImag               0;
        RReal               1;
        RImag               0;
        pRef                101325;
        resistiveFloor      1e-3;
        microstructure
        {
            type                    helmholtz;  // helmholtz | quarterWave | groove
            neckLength              0.002;
            neckRadius              0.0004;
            cavityVolume            8.0e-9;
            endCorrection           1.7;
            cellArea                4.0e-6;
            normalizedResistance    0.05;
            cavityDepth             0.004;
            grooveWidth             0.001;
            grooveLand              0.001;
            viscousResistance       1;
            initialDisplacement     0;
            initialVelocity         0;
        }
    }
}

ignition
{
    type                hotKernel;      // none | hotKernel | progressKernel | hotProgressKernel
    boxMin              (0.002 0.01 -0.001);
    boxMax              (0.008 0.03 0.002);
    TKernel             2500;
    lambdaKernel        0;
    initialPressure     101325;
    initialTemperature  300;
    initialLambda       0;
    inletLambda         0;
    initialVelocity
    {
        circumferential 0;
        axial           0;
        radial          0;
    }
}

optimization
{
    method              grid;           // grid | coordinate
    maxEvaluations      6;
    timeoutSeconds      3600;
    coordinateLevels    1;
    workDirectory       optimization;
    solverCommand       foamRun;
    objective
    {
        name            pressureGain;
        sense           maximize;       // maximize | minimize
        expression      "pMeanOutlet/pMeanInlet";
    }
    constraints
    (
        { quantity "geometry.steps[0].height"; max 0.008; }
        { quantity pMeanOutlet; min 0; }
    );
    designVariables
    (
        {
            name        "geometry.steps[0].height";
            min         0.001;
            max         0.003;
            samples     3;
        }
        {
            name        "geometry.steps[0].location";
            min         0.03;
            max         0.05;
            samples     2;
        }
    );
}

output
{
    fields              (p T U rho lambda);
    writeControl        adjustableRunTime;
    writeInterval       1e-6;
    purgeWrite          0;
    writeCompression    no;
    objectives
    (
        {
            name        pMeanOutlet;
            field       p;
            region      patch;
            patch       outlet;
            operation   areaAverage;
        }
        {
            name        pMeanInlet;
            field       p;
            region      patch;
            patch       injector;
            operation   areaAverage;
        }
        {
            name        TMax;
            field       T;
            region      volume;
            operation   max;
        }
        {
            name        lambdaMax;
            field       lambda;
            region      volume;
            operation   max;
        }
    );
}

// ************************************************************************* //
