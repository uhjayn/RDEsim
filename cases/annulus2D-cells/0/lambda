FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      lambda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    periodicLeft
    {
        type            cyclic;
    }
    periodicRight
    {
        type            cyclic;
    }
    outlet
    {
        type            zeroGradient;
    }
    injector
    {
        type            fixedValue;
        value           uniform 0;
    }
}

