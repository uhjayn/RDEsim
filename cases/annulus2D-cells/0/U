FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   uniform (0 0 0);

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    periodicLeft
    {
        type            cyclic;
    }
    periodicRight
    {
        type            cyclic;
    }
    outlet
    {
        type            zeroGradient;
    }
    injector
    {
        type            fixedValue;
        value           uniform (0 99.9144236758 0);
    }
}

