FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [pressure];

internalField   uniform 101325;

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    periodicLeft
    {
        type            cyclic;
    }
    periodicRight
    {
        type            cyclic;
    }
    outlet
    {
        type            waveTransmissive;
        gamma           1.4;
        fieldInf        101325;
        lInf            0.0056;
        value           uniform 101325;
    }
    injector
    {
        type            zeroGradient;
    }
}

