FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          rdeFluid;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2e-05;
deltaT          1e-08;
adjustTimeStep  yes;
maxCo           0.2;
maxDeltaT       2e-07;
deltaTFactor    1.2;

writeControl    adjustableRunTime;
writeInterval   2e-06;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;

functions
{
    pMeanOutlet
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   2e-06;
        writeFields     false;
        log             false;
        operation       areaAverage;
        patch           outlet;
        fields          (p);
    }
    pMeanInlet
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   2e-06;
        writeFields     false;
        log             false;
        operation       areaAverage;
        patch           injector;
        fields          (p);
    }
    TMax
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   2e-06;
        writeFields     false;
        log             false;
        operation       max;
        cellZone        all;
        fields          (T);
    }
    lambdaMax
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   2e-06;
        writeFields     false;
        log             false;
        operation       max;
        cellZone        all;
        fields          (lambda);
    }
}

