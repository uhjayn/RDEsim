FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   {
    type            zonal;
    defaultValue    300;
    zones
    {
        kernel
        {
            type            box;
            box             (0.002 0.01 -0.001) (0.008 0.03 0.002);
            value           2500;
        }
    }
};

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    injector
    {
        type            fixedValue;
        value           uniform 300;
    }
    injectorSide
    {
        type            zeroGradient;
    }
    periodicLeft
    {
        type            cyclic;
    }
    outlet
    {
        type            zeroGradient;
    }
    inletWall
    {
        type            zeroGradient;
    }
    periodicRight
    {
        type            cyclic;
    }
}

